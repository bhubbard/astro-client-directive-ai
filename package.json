{
  "name": "astro-client-directive-ai",
  "version": "0.1.0",
  "description": "Astro custom client directive to delay component hydration until Chrome Built-in AI (Gemini Nano) is ready",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/client.ts --outdir ./dist --target browser && tsc -p tsconfig.build.json",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-directive",
    "client-directive",
    "chrome-ai",
    "gemini-nano",
    "built-in-ai",
    "prompt-api",
    "web-ai"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
